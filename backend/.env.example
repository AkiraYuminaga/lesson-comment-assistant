# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Security Configuration
# HMAC secret for response signing (generate with: openssl rand -hex 32)
HMAC_SECRET=your_hmac_secret_here

# CORS allowed origins (comma-separated). The extension calls the API from its
# background service worker, so the target site does NOT need to be listed here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Logging
RUST_LOG=info,lesson_comment_backend=debug
